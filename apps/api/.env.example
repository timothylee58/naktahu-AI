# ── ILMU API (primary — chat + embeddings) ───────────────────
ILMU_API_KEY=your_ilmu_token_here
ILMU_BASE_URL=https://api.ilmu.gov.my/v1
# Confirm exact model name strings from ILMU API docs.
# Embedding dimension MUST be 1536 to match pgvector schema.
ILMU_CHAT_MODEL=ilmu-chat
ILMU_EMBEDDING_MODEL=ilmu-embedding

# ── Anthropic (synthesiser fallback only) ────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── OpenAI (commented out — ILMU covers embeddings) ─────────
# OPENAI_API_KEY=your_openai_key_here

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://default:password@your-railway-redis:6379

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=your_supabase_jwt_secret_here

# ── Observability ────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=naktahu-ai
SENTRY_DSN=your_sentry_dsn_here
ENV=development

# ── App ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# This API's own public URL — handed to HitPay as the webhook callback
# address per checkout request.
PUBLIC_API_URL=http://localhost:8000

# ── Stripe (freemium billing) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Price IDs from the Stripe dashboard — one per checkout item.
STRIPE_PRICE_PRO_INDIVIDU=price_your_pro_individu_id
STRIPE_PRICE_PRO_PERNIAGAAN=price_your_pro_perniagaan_id
STRIPE_PRICE_STUDENT=price_your_student_id
STRIPE_PRICE_CREDITS_5=price_your_credits_5_id
STRIPE_PRICE_CREDITS_20=price_your_credits_20_id
STRIPE_PRICE_CREDITS_50=price_your_credits_50_id

# ── HitPay (FPX/DuitNow QR — agent credit packs only) ────────
HITPAY_API_KEY=your_hitpay_business_api_key
# Separate secret from the API key — Payment Gateway > Payment Requests >
# Webhook in the HitPay dashboard.
HITPAY_SALT=your_hitpay_webhook_salt
# Sandbox by default. Production: https://api.hit-pay.com/v1
HITPAY_BASE_URL=https://api.sandbox.hit-pay.com/v1
