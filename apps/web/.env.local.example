NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Absolute site URL used for OpenGraph/Twitter card asset URLs
# (metadataBase in app/layout.tsx). Without it those URLs fall back to
# the Netlify default. Set to https://naktahu.my once the domain is live.
NEXT_PUBLIC_SITE_URL=https://naktahu.netlify.app
