# Supabase (frontend — use the public anon key, not the service key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Backend URL for Next.js rewrites (defaults to localhost in development)
API_BACKEND_URL=http://localhost:8000

# NOTE: this file is frontend-only. Server-side keys (SUPABASE_SERVICE_ROLE_KEY,
# NEMOTRON_*, TAVILY_API_KEY, JEV_*, Stripe/HitPay) live in apps/api/.env — see
# apps/api/.env.example. Never put them in a NEXT_PUBLIC_* variable.
